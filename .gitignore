# =====================================================================
# Project artefacts — the big ones
# =====================================================================
# QSD synthesis cache (qpy files, content-addressed, regenerable)
.cache/
**/synthesis_cache/
*.qpy.tmp
*.qpy.partial

# Benchmark results (parquet, npz, figures) — always regenerable
# results/
# **/results/

# =====================================================================
# Manim intermediate output (mp4 and partial renders);
# final GIFs in media/output/ ARE tracked
# =====================================================================
# Match at any depth in case manim is run from inside media/
**/videos/
**/partial_movie_files/
**/Tex/
**/texts/
media/output/*.mp4
media/output/*.webm

# =====================================================================
# Data — keep small samples, ignore large runs
# =====================================================================
# Keep the directory structure
!data/.gitkeep

# NOTE: no blanket ignore on data/**/*.json — every JSON in data/ is
# tracked by default. If you start adding large files and want to
# selectively track only small examples, restore the pattern below and
# un-comment the specific negations.
#
# data/**/*.json
# !data/h2_ovos.json
# !data/examples/

data/**/*.parquet
data/**/*.npz
data/**/*.h5

